{
  "name": "shopify-supertext-translation",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "node scripts/start.mjs",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "docs:movie": "npm --prefix test/docs install --no-audit --no-fund --no-package-lock && node test/docs/movie.mjs",
    "docs:movie:install": "npm --prefix test/docs install --no-audit --no-fund --no-package-lock && node test/docs/movie-install.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.5",
    "@react-router/fs-routes": "7.18.5",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@shopify/app-bridge-react": "^4.2.14",
    "@shopify/shopify-app-react-router": "^4.0.2",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.1",
    "isbot": "^5.1.31",
    "pg": "^8.23.1",
    "prisma": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/polaris-types": "2.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.14.0",
    "graphql-config": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0",
    "lodash": "^4.18.1",
    "deepmerge-ts": "^8.0.2",
    "@graphql-tools/utils@<12.1.0": "^12.1.0",
    "graphql-config": {
      "minimatch": "^11.0.5"
    },
    "@graphql-codegen/cli": {
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "version": "0.1.0",
  "description": "Supertext AI translation for Shopify: an embedded app that translates products, collections, pages and blog posts into the shop's other languages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Supertext/Shopify-Supertext-Translation.git"
  }
}
